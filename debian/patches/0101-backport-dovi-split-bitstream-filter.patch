+#include <stdbool.h>
+
+#include "libavutil/avassert.h"
+#include "libavutil/dovi_meta.h"
+#include "libavutil/dict.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+
+#include "avcodec.h"
+#include "bsf.h"
+#include "bsf_internal.h"
+#include "h2645_parse.h"
+#include "packet.h"
+
+#include "hevc/hevc.h"
+
+enum DOVISplitMode {
+    DOVI_SPLIT_BL     = 0,
+    DOVI_SPLIT_BL_RPU = 1,
+    DOVI_SPLIT_EL     = 2,
+    DOVI_SPLIT_EL_RPU = 3,
+};
+
+/* One DPB for pending PTS, one for decode-order output, plus one incoming packet. */
+#define TIMING_QUEUE_SIZE (2 * HEVC_MAX_DPB_SIZE + 1)
+
+typedef struct DOVITimedPacket {
+    AVPacket *pkt;
+    int poc;
+    unsigned epoch;
+    int assigned;
+    int key_frame;
+} DOVITimedPacket;
+
+typedef struct DOVITimestamp {
+    int64_t pts;
+    int64_t duration;
+} DOVITimestamp;
+
+typedef struct DOVISplitContext {
+    const AVClass *class;
+    int mode;
+    int fix_el_timing;
+    AVCodecParserContext *parser;
+    AVCodecContext *parser_ctx;
+    DOVITimedPacket queue[TIMING_QUEUE_SIZE];
+    DOVITimestamp timestamps[TIMING_QUEUE_SIZE];
+    int nb_queue, nb_timestamps;
+    int eof;
+    unsigned epoch;
+    int picture_count, starts_epoch;
+    int repairing, timing_failed;
+    int64_t last_pts;
+    unsigned last_epoch;
+    int last_poc;
+
+    int nal_length_size;        /* 0 means Annex-B input */
+    int out_nal_length_size;    /* 0 means Annex-B output */
+    H2645Packet pkt;
+} DOVISplitContext;
+
+static int hvcc_nal_length_size(const uint8_t *data, int size)
+{
+    if (size >= 23 && data[0] == 1 && AV_RB24(data) != 1 && AV_RB32(data) != 1)
+        return (data[21] & 3) + 1;
+    return 0;
+}
+
+static int dovi_split_init(AVBSFContext *ctx)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    bool keep_bl  = s->mode == DOVI_SPLIT_BL || s->mode == DOVI_SPLIT_BL_RPU;
+    bool keep_el  = s->mode == DOVI_SPLIT_EL || s->mode == DOVI_SPLIT_EL_RPU;
+    bool keep_rpu = s->mode == DOVI_SPLIT_BL_RPU || s->mode == DOVI_SPLIT_EL_RPU;
+
+    if (s->fix_el_timing) {
+        if (s->mode != DOVI_SPLIT_EL) {
+            av_log(ctx, AV_LOG_ERROR, "fix_el_timing requires mode=el; RPU timing belongs to the base layer.\n");
+            return AVERROR(EINVAL);
+        }
+        s->parser_ctx = avcodec_alloc_context3(NULL);
+        if (!s->parser_ctx)
+            return AVERROR(ENOMEM);
+    }
+
+    /* Profile 7 is currently the only supported variant with EL by Dolby.
+     * Default to that in case there is no DOVI config. */
+    uint8_t dv_profile = 7;
+
+    for (int i = 0; i < ctx->par_out->nb_coded_side_data; i++) {
+        AVPacketSideData *sd = &ctx->par_out->coded_side_data[i];
+        AVDOVIDecoderConfigurationRecord *cfg;
+        if (sd->type != AV_PKT_DATA_DOVI_CONF)
+            continue;
+        cfg = (AVDOVIDecoderConfigurationRecord *)sd->data;
+        cfg->bl_present_flag  &= keep_bl;
+        cfg->el_present_flag  &= keep_el;
+        cfg->rpu_present_flag &= keep_rpu;
+        dv_profile = cfg->dv_profile;
+        break;
+    }
+
+    if (keep_el) {
+        const AVPacketSideData *sd;
+        sd = av_packet_side_data_get(ctx->par_out->coded_side_data,
+                                     ctx->par_out->nb_coded_side_data,
+                                     AV_PKT_DATA_HEVC_CONF);
+        if (sd && sd->size >= 23) {
+            uint8_t *new_ed = av_mallocz(sd->size + AV_INPUT_BUFFER_PADDING_SIZE);
+            if (!new_ed)
+                return AVERROR(ENOMEM);
+            memcpy(new_ed, sd->data, sd->size);
+            av_freep(&ctx->par_out->extradata);
+            ctx->par_out->extradata = new_ed;
+            ctx->par_out->extradata_size = sd->size;
+        }
+
+        /* DV profile to EL size ratio */
+        static const uint8_t el_div[] = {
+            [2] = 2,
+            [3] = 1,
+            [4] = 2,
+            [6] = 2,
+            [7] = 2,
+        };
+        int div = dv_profile < FF_ARRAY_ELEMS(el_div) ? el_div[dv_profile] : 0;
+        if (!div)
+            av_log(ctx, AV_LOG_WARNING, "Unexpected DV Profile %d.\n", dv_profile);
+
+        /* P7: EL is 1:1 for FHD BL */
+        if (dv_profile == 7 && ctx->par_in->width <= 1920)
+            div = 1;
+        if (div > 1) {
+            ctx->par_out->width = ctx->par_in->width / div;
+            ctx->par_out->height = ctx->par_in->height / div;
+        }
+    }
+
+    /* Drop AV_PKT_DATA_HEVC_CONF as it's no longer valid on output. It's
+     * set as extradata for EL. */
+    av_packet_side_data_remove(ctx->par_out->coded_side_data,
+                               &ctx->par_out->nb_coded_side_data,
+                               AV_PKT_DATA_HEVC_CONF);
+
+    s->nal_length_size = hvcc_nal_length_size(ctx->par_in->extradata,
+                                              ctx->par_in->extradata_size);
+    s->out_nal_length_size = hvcc_nal_length_size(ctx->par_out->extradata,
+                                                  ctx->par_out->extradata_size);
+
+    s->last_pts = AV_NOPTS_VALUE;
+    if (s->fix_el_timing)
+        return avcodec_parameters_to_context(s->parser_ctx, ctx->par_out);
+    return 0;
+}
+
+static void dovi_split_flush(AVBSFContext *ctx)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    for (int i = 0; i < s->nb_queue; i++)
+        av_packet_free(&s->queue[i].pkt);
+    s->nb_queue = s->nb_timestamps = s->eof = s->epoch = 0;
+    s->repairing = s->timing_failed = 0;
+    s->last_pts = AV_NOPTS_VALUE;
+    av_parser_close(s->parser);
+    s->parser = NULL;
+}
+
+static void dovi_split_close(AVBSFContext *ctx)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    dovi_split_flush(ctx);
+    avcodec_free_context(&s->parser_ctx);
+    ff_h2645_packet_uninit(&s->pkt);
+}
+
+static int nal_is_kept(const DOVISplitContext *s, const H2645NAL *nal,
+                       const uint8_t **payload, int *payload_size)
+{
+    bool keep_el  = s->mode == DOVI_SPLIT_EL || s->mode == DOVI_SPLIT_EL_RPU;
+    bool keep_bl  = s->mode == DOVI_SPLIT_BL || s->mode == DOVI_SPLIT_BL_RPU;
+    bool keep_rpu = s->mode == DOVI_SPLIT_BL_RPU || s->mode == DOVI_SPLIT_EL_RPU;
+
+    switch (nal->type) {
+    case HEVC_NAL_UNSPEC63:
+        /* EL: keep only when extracting EL, strip two-bytes of outer NAL header */
+        if (!keep_el || nal->raw_size <= 2)
+            return 0;
+        *payload = nal->raw_data + 2;
+        *payload_size = nal->raw_size - 2;
+        return 1;
+    case HEVC_NAL_UNSPEC62:
+        /* RPU: kept verbatim only when the selected mode opted in. */
+        if (!keep_rpu)
+            return 0;
+        *payload = nal->raw_data;
+        *payload_size = nal->raw_size;
+        return 1;
+    default:
+        /* Anything else is a base-layer NAL. */
+        if (!keep_bl)
+            return 0;
+        *payload = nal->raw_data;
+        *payload_size = nal->raw_size;
+        return 1;
+    }
+}
+
+static int dovi_split_packet(AVBSFContext *ctx, AVPacket *out)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    AVPacket *in = NULL;
+    AVBufferRef *out_buf = NULL;
+    uint8_t *dst;
+    size_t out_size = 0;
+    int kept_count = 0;
+    int flags = (s->nal_length_size ? H2645_FLAG_IS_NALFF : 0) |
+                H2645_FLAG_SMALL_PADDING;
+    int prefix_size = s->out_nal_length_size ? s->out_nal_length_size : 4;
+    int ret;
+
+    ret = ff_bsf_get_packet(ctx, &in);
+    if (ret < 0)
+        return ret;
+
+    ret = ff_h2645_packet_split(&s->pkt, in->data, in->size, ctx,
+                                s->nal_length_size, AV_CODEC_ID_HEVC, flags);
+    if (ret < 0)
+        goto fail;
+
+    s->picture_count = s->starts_epoch = 0;
+    for (int i = 0; i < s->pkt.nb_nals; i++) {
+        const uint8_t *payload;
+        int payload_size;
+        if (!nal_is_kept(s, &s->pkt.nals[i], &payload, &payload_size))
+            continue;
+        if (s->fix_el_timing && payload_size >= 3) {
+            int type = (payload[0] >> 1) & 0x3f;
+            if (type < 32 && (payload[2] & 0x80)) {
+                s->picture_count++;
+                s->starts_epoch |= type >= HEVC_NAL_BLA_W_LP && type <= HEVC_NAL_IDR_N_LP;
+            }
+        }
+        out_size += prefix_size + payload_size;
+        kept_count++;
+    }
+
+    if (!kept_count) {
+        ret = AVERROR(EAGAIN);
+        goto fail;
+    }
+
+    out_buf = av_buffer_alloc(out_size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!out_buf) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    dst = out_buf->data;
+    for (int i = 0; i < s->pkt.nb_nals; i++) {
+        const uint8_t *payload;
+        int payload_size;
+        if (!nal_is_kept(s, &s->pkt.nals[i], &payload, &payload_size))
+            continue;
+        switch (s->out_nal_length_size) {
+        case 0: AV_WB32(dst, 1);            break;
+        case 1: AV_WB8 (dst, payload_size); break;
+        case 2: AV_WB16(dst, payload_size); break;
+        case 3: AV_WB24(dst, payload_size); break;
+        case 4: AV_WB32(dst, payload_size); break;
+        }
+        dst += prefix_size;
+        memcpy(dst, payload, payload_size);
+        dst += payload_size;
+    }
+    memset(dst, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    av_assert0(dst == out_buf->data + out_size);
+
+    ret = av_packet_copy_props(out, in);
+    if (ret < 0)
+        goto fail;
+
+    out->buf  = out_buf;
+    out->data = out_buf->data;
+    out->size = out_size;
+    out_buf   = NULL;
+
+fail:
+    av_buffer_unref(&out_buf);
+    av_packet_free(&in);
+    if (ret < 0 && ret != AVERROR(EAGAIN))
+        av_packet_unref(out);
+    return ret;
+}
+
+/* Mark untrusted EL timing so decoder-generated PTS cannot hide it. */
+static int dovi_split_mark_untrusted(AVPacket *pkt)
+{
+    AVDictionary *metadata = NULL;
+    size_t size;
+    const uint8_t *old = av_packet_get_side_data(pkt, AV_PKT_DATA_STRINGS_METADATA, &size);
+    uint8_t *data;
+    int ret;
+
+    if (old) {
+        ret = av_packet_unpack_dictionary(old, size, &metadata);
+        if (ret < 0)
+            goto end;
+    }
+    ret = av_dict_set(&metadata, "lavfi.dovi.el_timing_invalid", "1", 0);
+    if (ret < 0)
+        goto end;
+    data = av_packet_pack_dictionary(metadata, &size);
+    if (!data) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    ret = av_packet_add_side_data(pkt, AV_PKT_DATA_STRINGS_METADATA, data, size);
+    if (ret < 0)
+        av_free(data);
+end:
+    av_dict_free(&metadata);
+    return ret;
+}
+
+static void dovi_split_timing_fallback(AVBSFContext *ctx, const char *reason)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    av_log(ctx, AV_LOG_WARNING, "Cannot establish EL timing (%s); "
+           "disabling EL composition until the next flush.\n", reason);
+    s->timing_failed = 1;
+    s->nb_timestamps = 0;
+    /* Allow queued packets to drain without further timestamp repair. */
+    for (int i = 0; i < s->nb_queue; i++)
+        s->queue[i].assigned = 1;
+}
+
+/* Validate existing presentation timestamps in HEVC picture order. If their
+ * association is wrong, reassign the same timestamp slots as a best-effort
+ * repair. */
+static void dovi_split_assign_timestamp(AVBSFContext *ctx)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    DOVITimedPacket *p;
+    int picture = -1, timestamp = 0;
+    int64_t pts;
+
+    for (int i = 0; i < s->nb_queue; i++) {
+        DOVITimedPacket *q = &s->queue[i];
+        if (!q->assigned && (picture < 0 ||
+            q->epoch < s->queue[picture].epoch ||
+            (q->epoch == s->queue[picture].epoch && q->poc < s->queue[picture].poc)))
+            picture = i;
+    }
+    for (int i = 1; i < s->nb_timestamps; i++)
+        if (s->timestamps[i].pts < s->timestamps[timestamp].pts)
+            timestamp = i;
+
+    av_assert0(picture >= 0 && s->nb_timestamps > 0);
+    p = &s->queue[picture];
+    pts = s->timestamps[timestamp].pts;
+    for (int i = 0; i < s->nb_timestamps; i++) {
+        if (i != timestamp && s->timestamps[i].pts == pts) {
+            dovi_split_timing_fallback(ctx, "duplicate presentation timestamps");
+            return;
+        }
+    }
+    for (int i = 0; i < s->nb_queue; i++) {
+        DOVITimedPacket *q = &s->queue[i];
+        if (i != picture && !q->assigned && q->epoch == p->epoch && q->poc == p->poc) {
+            dovi_split_timing_fallback(ctx, "duplicate HEVC picture order");
+            return;
+        }
+    }
+    if (s->last_pts != AV_NOPTS_VALUE &&
+        (pts <= s->last_pts || p->epoch < s->last_epoch ||
+         (p->epoch == s->last_epoch && p->poc <= s->last_poc))) {
+        dovi_split_timing_fallback(ctx, "duplicate or discontinuous picture order/timestamps");
+        return;
+    }
+    if (p->pkt->pts != pts) {
+        if (!s->repairing)
+            av_log(ctx, AV_LOG_INFO, "EL timestamps disagree with HEVC picture order; "
+                   "repairing their association automatically.\n");
+        s->repairing = 1;
+        av_log(ctx, AV_LOG_DEBUG, "EL timing: epoch %u POC %d pts %"PRId64" -> %"PRId64"\n",
+               p->epoch, p->poc, p->pkt->pts, pts);
+        p->pkt->pts = pts;
+        p->pkt->duration = s->timestamps[timestamp].duration;
+    }
+    p->assigned = 1;
+    s->last_pts = pts;
+    s->last_epoch = p->epoch;
+    s->last_poc = p->poc;
+    s->timestamps[timestamp] = s->timestamps[--s->nb_timestamps];
+}
+
+static int dovi_split_filter(AVBSFContext *ctx, AVPacket *out)
+{
+    DOVISplitContext *s = ctx->priv_data;
+    if (!s->fix_el_timing)
+        return dovi_split_packet(ctx, out);
+
+    for (;;) {
+        DOVITimedPacket *p;
+        uint8_t *parsed;
+        int parsed_size, ret;
+
+        if (s->nb_queue && s->queue[0].assigned) {
+            p = &s->queue[0];
+            av_packet_move_ref(out, p->pkt);
+            if (s->repairing) {
+                /* BL DTS and keyframe flags may not match the EL. */
+                out->dts = AV_NOPTS_VALUE;
+                out->flags = (out->flags & ~AV_PKT_FLAG_KEY) |
+                             (p->key_frame ? AV_PKT_FLAG_KEY : 0);
+            }
+            av_packet_free(&p->pkt);
+            memmove(s->queue, s->queue + 1, --s->nb_queue * sizeof(*s->queue));
+            return s->timing_failed ? dovi_split_mark_untrusted(out) : 0;
+        }
+        if (s->nb_timestamps > HEVC_MAX_DPB_SIZE || (s->eof && s->nb_timestamps)) {
+            dovi_split_assign_timestamp(ctx);
+            continue;
+        }
+        if (s->eof)
+            return AVERROR_EOF;
+        if (s->timing_failed) {
+            ret = dovi_split_packet(ctx, out);
+            return ret < 0 ? ret : dovi_split_mark_untrusted(out);
+        }
+        if (s->nb_queue == TIMING_QUEUE_SIZE) {
+            dovi_split_timing_fallback(ctx, "reordering exceeds the HEVC queue bound");
+            continue;
+        }
+
+        ret = dovi_split_packet(ctx, out);
+        if (ret == AVERROR_EOF) {
+            s->eof = 1;
+            continue;
+        }
+        if (ret < 0)
+            return ret;
+        if (s->picture_count != 1 || out->pts == AV_NOPTS_VALUE) {
+            dovi_split_timing_fallback(ctx, s->picture_count != 1 ?
+                                      "access unit does not contain one EL picture" :
+                                      "missing presentation timestamp");
+            goto enqueue;
+        }
+        if (!s->parser) {
+            s->parser = av_parser_init(AV_CODEC_ID_HEVC);
+            if (!s->parser) {
+                av_packet_unref(out);
+                return AVERROR(ENOMEM);
+            }
+            s->parser->flags |= PARSER_FLAG_COMPLETE_FRAMES;
+        }
+        s->parser->output_picture_number = INT_MIN;
+        ret = av_parser_parse2(s->parser, s->parser_ctx, &parsed, &parsed_size,
+                               out->data, out->size, out->pts, out->dts, out->pos);
+        if (ret < 0 || s->parser->output_picture_number == INT_MIN) {
+            if (ret == AVERROR(ENOMEM)) {
+                av_packet_unref(out);
+                return ret;
+            }
+            dovi_split_timing_fallback(ctx, "cannot parse HEVC picture order");
+        }
+enqueue:
+        p = &s->queue[s->nb_queue];
+        p->pkt = av_packet_alloc();
+        if (!p->pkt) {
+            av_packet_unref(out);
+            return AVERROR(ENOMEM);
+        }
+        p->assigned = s->timing_failed;
+        p->key_frame = !!(out->flags & AV_PKT_FLAG_KEY);
+        if (!s->timing_failed) {
+            s->epoch += s->starts_epoch;
+            p->epoch = s->epoch;
+            p->poc = s->parser->output_picture_number;
+            p->key_frame = s->parser->key_frame;
+            s->timestamps[s->nb_timestamps++] = (DOVITimestamp){out->pts, out->duration};
+        }
+        av_packet_move_ref(p->pkt, out);
+        s->nb_queue++;
+    }
+}
