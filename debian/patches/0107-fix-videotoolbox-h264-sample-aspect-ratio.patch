+/*
+ * The hardware H.264 encoder does not write aspect_ratio_info to the SPS VUI,
+ * so anamorphic content is shown with square pixels by players that rely on
+ * the bitstream (e.g. MPEG-TS/HLS output). Signal the SAR with h264_metadata.
+ * Reported to Apple as FB25427151.
+ */
+static av_cold int vtenc_init_sar_bsf(AVCodecContext *avctx)
+{
+    VTEncContext *vtctx = avctx->priv_data;
+    AVRational sar = avctx->sample_aspect_ratio;
+    char str[64];
+    int ret;
+
+    if (avctx->codec_id != AV_CODEC_ID_H264 ||
+        sar.num <= 0 || sar.den <= 0 || sar.num == sar.den)
+        return 0;
+
+    snprintf(str, sizeof(str), "h264_metadata=sample_aspect_ratio=%d/%d",
+             sar.num, sar.den);
+    ret = av_bsf_list_parse_str(str, &vtctx->bsf);
+    if (ret < 0)
+        return ret;
+
+    ret = avcodec_parameters_from_context(vtctx->bsf->par_in, avctx);
+    if (ret < 0)
+        return ret;
+    vtctx->bsf->time_base_in = avctx->time_base;
+    ret = av_bsf_init(vtctx->bsf);
+    if (ret < 0)
+        return ret;
+
+    if (avctx->extradata) {
+        const AVCodecParameters *par = vtctx->bsf->par_out;
+        uint8_t *extradata = av_mallocz(par->extradata_size +
+                                        AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!extradata)
+            return AVERROR(ENOMEM);
+        memcpy(extradata, par->extradata, par->extradata_size);
+        av_free(avctx->extradata);
+        avctx->extradata      = extradata;
+        avctx->extradata_size = par->extradata_size;
+    }
+
+    return 0;
+}
+
