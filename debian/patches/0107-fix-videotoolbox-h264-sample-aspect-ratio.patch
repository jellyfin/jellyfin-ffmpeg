+/*
+ * The hardware H.264 encoders accept kVTCompressionPropertyKey_PixelAspectRatio
+ * but do not write aspect_ratio_info to the SPS VUI (frequently there is no
+ * VUI at all), so the sample aspect ratio only survives in containers that
+ * carry it out of band, such as the MP4 pasp box. In MPEG-TS and HLS the
+ * picture is shown with square pixels, e.g. 704x576 16:9 PAL SD becomes 11:9.
+ * Rewrite the SPS to signal the sample aspect ratio when the encoder left it out.
+ */
+static int rewrite_h264_sps_sar(AVCodecContext *avctx,
+                                const uint8_t  *ps,
+                                size_t          ps_size)
+{
+    VTEncContext *vtctx = avctx->priv_data;
+    CodedBitstreamContext *cbc = NULL;
+    CodedBitstreamFragment frag = { 0 };
+    H264RawSPS *sps = NULL;
+    uint8_t *buf = NULL;
+    const uint8_t *data;
+    size_t size;
+    int num, den, i, ret;
+
+    av_freep(&vtctx->sps_in);
+    av_freep(&vtctx->sps_out);
+    vtctx->sps_in_size  = 0;
+    vtctx->sps_out_size = 0;
+
+    vtctx->sps_in = av_memdup(ps, ps_size);
+    if (!vtctx->sps_in)
+        return AVERROR(ENOMEM);
+    vtctx->sps_in_size = ps_size;
+
+    buf = av_malloc(sizeof(start_code) + ps_size);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    memcpy(buf, start_code, sizeof(start_code));
+    memcpy(buf + sizeof(start_code), ps, ps_size);
+
+    ret = ff_cbs_init(&cbc, AV_CODEC_ID_H264, avctx);
+    if (ret < 0)
+        goto end;
+
+    ret = ff_cbs_read(cbc, &frag, NULL, buf, sizeof(start_code) + ps_size);
+    if (ret < 0)
+        goto end;
+
+    for (i = 0; i < frag.nb_units; i++) {
+        if (frag.units[i].type == H264_NAL_SPS) {
+            sps = frag.units[i].content;
+            break;
+        }
+    }
+    if (!sps) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+
+    /* The encoder signalled an aspect ratio itself: keep its SPS. */
+    if (sps->vui_parameters_present_flag && sps->vui.aspect_ratio_info_present_flag)
+        goto end;
+
+    av_reduce(&num, &den, avctx->sample_aspect_ratio.num,
+              avctx->sample_aspect_ratio.den, 65535);
+
+    for (i = 1; i < FF_ARRAY_ELEMS(ff_h2645_pixel_aspect); i++) {
+        if (num == ff_h2645_pixel_aspect[i].num &&
+            den == ff_h2645_pixel_aspect[i].den)
+            break;
+    }
+    if (i == FF_ARRAY_ELEMS(ff_h2645_pixel_aspect)) {
+        sps->vui.aspect_ratio_idc = 255;
+        sps->vui.sar_width        = num;
+        sps->vui.sar_height       = den;
+    } else {
+        sps->vui.aspect_ratio_idc = i;
+    }
+    sps->vui.aspect_ratio_info_present_flag = 1;
+    sps->vui_parameters_present_flag        = 1;
+
+    ret = ff_cbs_write_fragment_data(cbc, &frag);
+    if (ret < 0)
+        goto end;
+
+    /* Strip the Annex B start code written by CBS. */
+    data = frag.data;
+    size = frag.data_size;
+    while (size > 1 && !data[0]) {
+        data++;
+        size--;
+    }
+    if (size < 2 || data[0] != 1) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+    data++;
+    size--;
+
+    vtctx->sps_out = av_memdup(data, size);
+    if (!vtctx->sps_out) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    vtctx->sps_out_size = size;
+
+end:
+    ff_cbs_fragment_free(&frag);
+    ff_cbs_close(&cbc);
+    av_free(buf);
+    return ret;
+}
+
+/*
+ * Wraps get_param_set_func() and substitutes the SAR-fixed H.264 SPS
+ * (see rewrite_h264_sps_sar()) when one is needed.
+ */
+static int get_param_set(AVCodecContext              *avctx,
+                         CMVideoFormatDescriptionRef vid_fmt,
+                         size_t                      index,
+                         const uint8_t               **ps,
+                         size_t                      *ps_size)
+{
+    VTEncContext *vtctx = avctx->priv_data;
+    AVRational sar = avctx->sample_aspect_ratio;
+    int status;
+
+    status = vtctx->get_param_set_func(vid_fmt, index, ps, ps_size, NULL, NULL);
+    if (status)
+        return status;
+
+    if (vtctx->codec_id != AV_CODEC_ID_H264 ||
+        sar.num <= 0 || sar.den <= 0 || sar.num == sar.den ||
+        !*ps_size || ((*ps)[0] & 0x1F) != H264_NAL_SPS)
+        return 0;
+
+    if (!vtctx->sps_in || vtctx->sps_in_size != *ps_size ||
+        memcmp(vtctx->sps_in, *ps, *ps_size)) {
+        int ret = rewrite_h264_sps_sar(avctx, *ps, *ps_size);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_WARNING,
+                   "Could not add the sample aspect ratio to the SPS: %s\n",
+                   av_err2str(ret));
+            av_freep(&vtctx->sps_out);
+            vtctx->sps_out_size = 0;
+        }
+    }
+
+    if (vtctx->sps_out) {
+        *ps      = vtctx->sps_out;
+        *ps_size = vtctx->sps_out_size;
+    }
+
+    return 0;
+}
