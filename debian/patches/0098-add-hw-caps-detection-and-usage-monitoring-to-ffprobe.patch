+    if (mf_functions.MFShutdown)
+        mf_functions.MFShutdown();
+#   if !HAVE_UWP
+    if (mf_library) {
+        dlclose(mf_library);
+        mf_library = NULL;
+    }
+#   endif
+    memset(&mf_functions, 0, sizeof(mf_functions));
+#endif
