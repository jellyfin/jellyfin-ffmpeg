+av_unused static void get_hwaccel_device_index(int *device_idx, const char *hwaccel_device)
+{
+    if (!device_idx)
+        return;
+
+    *device_idx = -1;
+
+    if (hwaccel_device) {
+        char *end_ptr = NULL;
+        long val = strtol(hwaccel_device, &end_ptr, 10);
+
+        if (hwaccel_device == end_ptr ||
+            *end_ptr != '\0'          ||
+            errno == ERANGE           ||
+            val < 0                   ||
+            val > FFPROBE_HW_MAX_DEV_NUM) {
+            *device_idx = -1;
+        } else
+            *device_idx = (int)val;
+    }
+}
